{
  "name": "Aercom Servicios",
  "dockerComposeFile": "compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/Aercom-Gestion-Servicios",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {"label": "Aercom · Piloto", "onAutoForward": "notify"}
  },
  "postCreateCommand": "python -m pip install --user -r requirements.txt",
  "postStartCommand": "bash .devcontainer/iniciar.sh"
}
