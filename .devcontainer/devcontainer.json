{
  "name": "Aercom Servicios",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Aercom · Vista de prueba",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "nohup python -m http.server 8000 --bind 0.0.0.0 --directory web >/tmp/aercom-vista.log 2>&1 < /dev/null &"
}
